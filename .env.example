# ---------------------------------------------------------------------------
# Firebase client configuration
#
# A Firebase *web* API key is not a secret — it is designed to ship in browser
# bundles and is protected by Firestore security rules. What actually protects
# the project is API-key restriction. Before launch, in Google Cloud Console:
#
#   APIs & Services → Credentials → your browser key:
#     • Application restrictions → "Web site"
#     • Authorized domains → your production domain ONLY (add localhost for dev)
#     • API restrictions → allow only Identity Toolkit + Firestore
#
# Also disable public account creation in Firebase Console → Authentication →
# Sign-in method, unless you want strangers creating accounts on your project.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyBCcc8L95wBpGWi5eM5e9MqmuxpMB55ZMg"
VITE_FIREBASE_AUTH_DOMAIN="startup-junction-abc.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="startup-junction-abc"
VITE_FIREBASE_STORAGE_BUCKET="startup-junction-abc.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="627940415914"
VITE_FIREBASE_APP_ID="1:627940415914:web:5c7130993f6dfbfab0b3d3"
VITE_FIREBASE_DATABASE_ID="(default)"

# Absolute origin of the deployed site. Used for canonical URLs, og:url,
# sitemap and robots.txt references.
VITE_SITE_URL="https://startupjunction.in"